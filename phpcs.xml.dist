<?xml version="1.0"?>
<ruleset name="WP Bouncer">
    <description>WordPress Coding Standards for WP Bouncer.</description>

    <!-- Only the shipped plugin is checked; tests and tooling live outside it. -->
    <file>wp-bouncer</file>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="minimum_supported_wp_version" value="5.8"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress">
        <!-- PSR-4 file names (src/Rules/WafRule.php) instead of class-waf-rule.php. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-bouncer"/>
            </property>
        </properties>
    </rule>
</ruleset>
